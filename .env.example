# ========================================================
# 🇰🇭 ANGKOR EYES - ENVIRONMENT CONFIGURATION
# ========================================================

# --- Telegram Bot & Mini App ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# Comma-separated list of Telegram User IDs allowed to access ANGKOR EYES
ALLOWED_TELEGRAM_IDS=123456789

# --- Server Ports & Host ---
PORT=3000
HOST=0.0.0.0
JWT_SECRET=angkor-eyes-super-secret-jwt-key-2026

# --- Database & Queue (Optional - SQLite/In-memory fallback enabled by default) ---
# DATABASE_URL=postgresql://angkor:angkor_secret_password@localhost:5432/angkor_eyes
# REDIS_URL=redis://localhost:6379
DATA_PATH=./data

# --- Local Runner Daemon Token ---
# Secret token shared between Backend and Local Runner Daemon
RUNNER_TOKEN=angkor-runner-token-secure-key
RUNNER_BACKEND_URL=ws://localhost:3000/runner-ws
WORKTREE_BASE_DIR=../worktrees
RUNNER_TIMEOUT_MS=60000

# --- LLM API Providers (Model Routing) ---
# Google Gemini API Key (Recommended default)
GEMINI_API_KEY=AIzaSy...
# Anthropic Claude API Key (For Dev & Code Reviewer)
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI API Key
OPENAI_API_KEY=sk-...
# Ollama Local LLM (Offline & Free)
OLLAMA_BASE_URL=http://localhost:11434

# --- Models ---
DEFAULT_MODEL=gemini-2.5-flash
LEAD_MODEL=gemini-2.5-flash
DEV_MODEL=gemini-2.5-pro

# --- Safety & Anti-Collision ---
MAX_TURNS_PER_TRIGGER=6
AUTO_APPROVAL_MODE=false
