# ANGKOR EYES backend — copy to .env and fill in. NEVER commit a real .env.
# Placeholders only — no real secrets in this file.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL (source of truth). Example: postgres://user:pass@localhost:5432/angkor_eyes
DATABASE_URL=postgres://postgres:postgres@localhost:5432/angkor_eyes
# Redis (queue / locks / realtime only)
REDIS_URL=redis://localhost:6379

# Telegram bot token (bot agent owns the bot; backend only validates initData)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Comma-separated Telegram user IDs allowed to use the platform
ALLOWED_TELEGRAM_IDS=123456789

# LLM providers — leave empty for providers you do not use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Default model routing (override per task type in code if needed)
LLM_FAST_MODEL=gemini-2.0-flash
LLM_STRONG_MODEL=claude-sonnet-4-5

# Sentry / OpenTelemetry (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Object storage for attachments (S3-compatible / R2)
S3_ENDPOINT=
S3_BUCKET=angkor-eyes-attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# GitHub / GitLab webhooks (verified via HMAC secret)
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_TOKEN=
# Billing webhooks
STRIPE_WEBHOOK_SECRET=
# Kill switch: set STOP_ALL=true to halt all agent execution
STOP_ALL=false
